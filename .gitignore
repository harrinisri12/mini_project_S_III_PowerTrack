# ==============================================================================
# PowerTrack - Git Ignore Configuration
# ==============================================================================

# Environment and sensitive credentials
.env
.env.*
!.env.example
*.env
*.env.local
*.env.*.local
backend/.env
backend/.env.*

# Java compiled bytecode (*.class)
*.class
**/*.class

# Java packaging and archives (excluding required JDBC driver)
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Java build output directories
target/
build/
bin/
out/
.gradle/

# IDE and Editor configuration
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs, crash dumps, and temporary files
*.log
*.tmp
*.bak
*.swp
*~
hs_err_pid*
replay_pid*
