# ==============================================================================
# PowerTrack - Supabase PostgreSQL Database Environment Configuration
# ==============================================================================
# Fill in your Supabase connection parameters below.
# DO NOT commit the real .env file with actual passwords to version control.

# JDBC URL for Supabase PostgreSQL (Session pooler port 5432, Transaction pooler port 6543, or Direct db port 5432)
# Example Pooler URL: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Example Direct URL: jdbc:postgresql://db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database User:
# For Supabase Pooler: postgres.xxxxxxxxxxxxxxxxxxxx
# For Supabase Direct: postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx

# Database Password set during Supabase project creation
SUPABASE_DB_PASSWORD=your_supabase_password_here
